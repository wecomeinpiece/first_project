Sub CreateNextSheetFromList1()
    Dim wsNew As Worksheet
    Dim wsSource As Worksheet
    Dim N As Long
    Dim nextRow As Long
    
    ' Проверяем, есть ли уже лист "Некст"
    On Error Resume Next
    Set wsNew = ThisWorkbook.Sheets("Некст")
    On Error GoTo 0
    
    If Not wsNew Is Nothing Then
        MsgBox "Лист «Некст» уже существует!", vbInformation
        Exit Sub
    End If
    
    ' Определяем исходный лист
    Set wsSource = ThisWorkbook.Sheets("Лист1")
    
    ' Создаём новый лист
    Set wsNew = ThisWorkbook.Worksheets.Add
    wsNew.Name = "Некст"
    
    N = 2
    nextRow = 1
    
    ' Проверяем, что есть данные для обработки
    If IsEmpty(wsSource.Cells(N, "G").Value) Or wsSource.Cells(N, "G").Value = "" Then
        MsgBox "Нет данных для обработки.", vbInformation
        Exit Sub
    End If
    
    ' ---- Первая строка: всегда копируем все три значения (Шаг 1-3) ----
    ' Шаг 1: G > A, метка 1 в B
    wsNew.Cells(nextRow, "A").Value = wsSource.Cells(N, "G").Value
    wsNew.Cells(nextRow, "B").Value = 1
    nextRow = nextRow + 1
    
    ' Шаг 2: H > A, метка 2 в B
    wsNew.Cells(nextRow, "A").Value = wsSource.Cells(N, "H").Value
    wsNew.Cells(nextRow, "B").Value = 2
    nextRow = nextRow + 1
    
    ' Шаг 3: B > A, метка 3 в B, C > C
    wsNew.Cells(nextRow, "A").Value = wsSource.Cells(N, "B").Value
    wsNew.Cells(nextRow, "B").Value = 3
    wsNew.Cells(nextRow, "C").Value = wsSource.Cells(N, "C").Value
    nextRow = nextRow + 1
    N = N + 1
    
    Do
        ' Проверяем, пустая ли строка N (по столбцу G)
        If IsEmpty(wsSource.Cells(N, "G").Value) Or wsSource.Cells(N, "G").Value = "" Then
            Exit Do
        End If
        
        ' Шаг 4: сравниваем G(N) и G(N-1)
        If wsSource.Cells(N, "G").Value <> wsSource.Cells(N - 1, "G").Value Then
            ' G изменилось — Шаг 1 > Шаг 2 > Шаг 3
            wsNew.Cells(nextRow, "A").Value = wsSource.Cells(N, "G").Value
            wsNew.Cells(nextRow, "B").Value = 1
            nextRow = nextRow + 1
            wsNew.Cells(nextRow, "A").Value = wsSource.Cells(N, "H").Value
            wsNew.Cells(nextRow, "B").Value = 2
            nextRow = nextRow + 1
            wsNew.Cells(nextRow, "A").Value = wsSource.Cells(N, "B").Value
            wsNew.Cells(nextRow, "B").Value = 3
            wsNew.Cells(nextRow, "C").Value = wsSource.Cells(N, "C").Value
            nextRow = nextRow + 1
            N = N + 1
            
        ' Шаг 5: сравниваем H(N) и H(N-1)
        ElseIf wsSource.Cells(N, "H").Value <> wsSource.Cells(N - 1, "H").Value Then
            ' H изменилось — Шаг 2 > Шаг 3
            wsNew.Cells(nextRow, "A").Value = wsSource.Cells(N, "H").Value
            wsNew.Cells(nextRow, "B").Value = 2
            nextRow = nextRow + 1
            wsNew.Cells(nextRow, "A").Value = wsSource.Cells(N, "B").Value
            wsNew.Cells(nextRow, "B").Value = 3
            wsNew.Cells(nextRow, "C").Value = wsSource.Cells(N, "C").Value
            nextRow = nextRow + 1
            N = N + 1
            
        Else
            ' G и H не изменились — только Шаг 3
            wsNew.Cells(nextRow, "A").Value = wsSource.Cells(N, "B").Value
            wsNew.Cells(nextRow, "B").Value = 3
            wsNew.Cells(nextRow, "C").Value = wsSource.Cells(N, "C").Value
            nextRow = nextRow + 1
            N = N + 1
        End If
    Loop
    
    MsgBox "Готово! Скопировано строк: " & (nextRow - 1), vbInformation
End Sub
